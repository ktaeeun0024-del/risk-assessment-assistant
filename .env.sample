OPENROUTER_API_KEY=
DATABASE_URL=
# 선택: 비워 두면 nvidia/nemotron-3-ultra-550b-a55b:free (검증 측정으로 고른 무료 모델). 다른 무료 모델로 바꿀 때만
OPENROUTER_MODEL=
# 배포용: Supabase Edge Function 주소 https://<프로젝트 ref>.supabase.co/functions/v1/ai-draft
# 넣으면 AI 초안을 Supabase에서 뒤에서 만든다 (Netlify 무료 함수는 약 10초 제한). 실습서버 개발에서는 비워 둔다
AI_JOB_URL=
# 선택: AI_JOB_URL이 없을 때 AI 대기 시간(ms). 기본 90000
AI_TIMEOUT_MS=
# 회사 가입 승인: 승인 화면을 쓸 사이트 관리자 이메일 (쉼표로 여러 명)
SITE_ADMIN_EMAILS=
# 인증번호 메일 (Gmail SMTP): 보내는 Gmail 주소와 Gmail '앱 비밀번호' 16자리
SMTP_USER=
SMTP_PASS=
# 선택: 국세청 사업자등록 상태조회 (공공데이터포털 일반 인증키. 키가 한 칸만 보이면 그 값을 그대로). 없으면 '확인 못 함'으로 저장
NTS_SERVICE_KEY=
