OPENROUTER_API_KEY=
DATABASE_URL=
# 선택: 비워 두면 openrouter/free. 검증 측정 때 무료 모델 하나로 고정
OPENROUTER_MODEL=
# 선택: AI 대기 시간(ms). Netlify처럼 실행 시간 제한이 짧은 곳에서는 8000 정도로
AI_TIMEOUT_MS=
# 회사 가입 승인: 승인 화면을 쓸 사이트 관리자 이메일 (쉼표로 여러 명)
SITE_ADMIN_EMAILS=
# 인증번호 메일 (Gmail SMTP): 보내는 Gmail 주소와 Gmail '앱 비밀번호' 16자리
SMTP_USER=
SMTP_PASS=
# 선택: 국세청 사업자등록 상태조회 (공공데이터포털 일반 인증키, Decoding). 없으면 '확인 못 함'으로 저장
NTS_SERVICE_KEY=
